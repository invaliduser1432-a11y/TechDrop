# Copy server secrets to .dev.vars for local Workers. Never use PUBLIC_ prefixes.
# Non-secret APP_MODE/SITE_URL also live in both wrangler configuration files.
APP_MODE=demo
SITE_URL=http://localhost:4321
ALLOW_LOCAL_ADMIN=true
# demo:seed generates a random LOCAL_ADMIN_TOKEN in .dev.vars if it does not exist.
LOCAL_ADMIN_TOKEN=
LIVE_PUBLISHING_ALLOWED=false

# Production administrator identity; configure Cloudflare Access before deployment.
ACCESS_TEAM_DOMAIN=your-team.cloudflareaccess.com
ACCESS_AUD=
ADMIN_EMAILS=

# Buffer server credential; never put it in a browser form or commit it.
BUFFER_TOKEN=
# Approved eBay production keyset for unattended application-token renewal.
EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=
# Optional short-lived token override; remove it to use automatic renewal.
EBAY_ACCESS_TOKEN=
# Your actual approved eBay Partner Network campaign ID, if eligible.
EBAY_CAMPAIGN_ID=
# Explicitly authorized retailer/image hosts, comma-separated (no schemes/wildcards).
FEED_HOSTS=

# Amazon US Creators API OAuth credentials, version 3.1 (not old PA-API keys).
# Set on BOTH workers. Written Amazon agreement for this price-tracking site
# is required; the reference is not a substitute for actually obtaining it.
AMAZON_CREATORS_CLIENT_ID=
AMAZON_CREATORS_CLIENT_SECRET=
AMAZON_PARTNER_TAG=
AMAZON_SITE_APPROVAL_REFERENCE=

# Best Buy Products API access; confirm your site's use meets the API terms.
BESTBUY_API_KEY=
BESTBUY_API_APPROVED=false
# Optional approved Impact partner account. Without it, links earn no commission.
BESTBUY_IMPACT_PARTNER_ID=
# Exact hosts used in affiliateUrl returned for YOUR partner ID; no wildcards.
BESTBUY_AFFILIATE_HOSTS=
