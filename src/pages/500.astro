---
import Layout from '../layouts/Layout.astro';
Astro.response.status = 503;
Astro.response.headers.set('Retry-After', '60');
---

<Layout title="Temporarily unavailable" noindex>
  <div class="container">
    <div class="empty" style="margin:60px 0">
      <h1>Our radar is taking a moment.</h1>
      <p>Deal data is temporarily unavailable. Try again shortly.</p>
      <a class="button" href="/">
        Try again
      </a>
    </div>
  </div>
</Layout>
