{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "dealradar-jobs",
  "account_id": "917b89b50f003dd0ffdb1bb30f4b3894",
  "workers_dev": false,
  "preview_urls": false,
  "main": "src/lib/jobs/worker.ts",
  "compatibility_date": "2026-10-14",
  "triggers": { "crons": ["*/30 * * * *"] },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "dealradar",
      "database_id": "aa54ef07-76b5-4208-ad69-73500edec29e",
      "migrations_dir": "migrations",
    },
  ],
  "vars": {
    "APP_MODE": "production",
    "SITE_URL": "https://dealradar.dealradar-1432.workers.dev",
    "LIVE_PUBLISHING_ALLOWED": "false",
  },
}
