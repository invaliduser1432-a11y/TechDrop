{
  "name": "dealradar",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node scripts/run.mjs astro dev --host 0.0.0.0",
    "build": "node scripts/run.mjs astro build",
    "preview": "node scripts/run.mjs wrangler dev",
    "check": "node scripts/run.mjs astro check && node scripts/run.mjs tsc --noEmit",
    "lint": "node scripts/run.mjs eslint src tests scripts",
    "test": "node scripts/run.mjs vitest run",
    "test:e2e": "node scripts/run.mjs node scripts/prepare-e2e.mjs && node scripts/run.mjs playwright test",
    "db:migrate": "node scripts/run.mjs wrangler d1 migrations apply dealradar --local",
    "demo:seed": "node scripts/run.mjs node scripts/seed.mjs",
    "deploy": "npm run build && node scripts/run.mjs wrangler deploy",
    "jobs:dev": "node scripts/run.mjs wrangler dev --config wrangler.jobs.jsonc --test-scheduled",
    "jobs:deploy": "node scripts/run.mjs wrangler deploy --config wrangler.jobs.jsonc",
    "format": "node scripts/run.mjs prettier --write src scripts tests *.mjs *.ts *.json *.jsonc"
  },
  "dependencies": {
    "@astrojs/cloudflare": "14.3.4",
    "@astrojs/react": "7.0.1",
    "@tailwindcss/vite": "^4.0.0",
    "astro": "7.3.8",
    "jose": "^6.0.0",
    "papaparse": "^5.5.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "recharts": "^3.0.0",
    "tailwindcss": "^4.0.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.6",
    "@cloudflare/workers-types": "5.20261014.1",
    "@playwright/test": "1.64.1",
    "@types/node": "^24.0.0",
    "@types/papaparse": "^5.3.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "eslint": "^9.0.0",
    "eslint-plugin-astro": "^1.3.0",
    "prettier": "^3.9.10",
    "prettier-plugin-astro": "^1.1.1",
    "typescript": "^6.0.0",
    "typescript-eslint": "^8.0.0",
    "vitest": "5.0.4",
    "wrangler": "4.151.0"
  }
}
